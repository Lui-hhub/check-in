[Unit]
Description=Check-in Next.js Frontend
After=network.target check-in-backend.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/check-in/frontend
Environment=NODE_ENV=production
Environment=PORT=3000
Environment="PATH=/home/ubuntu/.nvm/versions/node/v24.21.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
ExecStart=/home/ubuntu/.nvm/versions/node/v24.21.0/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

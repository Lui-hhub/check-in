DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/check_in
VIEWER_PASSWORD=view-password
UPLOADER_PASSWORD=upload-password
ADMIN_PASSWORD=admin-password
JWT_SECRET=change-me
FACE_MATCH_THRESHOLD=0.60
